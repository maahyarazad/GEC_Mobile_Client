# Test-only environment. CRA loads .env.test when NODE_ENV=test; it does not
# load .env.development, so without this src/utils/constants/constants.ts
# throws at import time and every suite fails to run.
REACT_APP_NODE_ENV=development
REACT_APP_NODE_MODE=local
REACT_APP_PROXY=
REACT_APP_API_URL=http://localhost:3300
