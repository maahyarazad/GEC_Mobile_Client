# development | production
REACT_APP_NODE_ENV=development

# prod | staging | dev | local
REACT_APP_NODE_MODE=local

# Empty for local dev — no proxy prefix needed
REACT_APP_PROXY=

# Local API server
REACT_APP_API_URL=http://192.168.1.200:3299

# Deep link App URL for development
REACT_APP_DEV_APP_DEEPLINK=exp://192.168.0.197:19000/--/
